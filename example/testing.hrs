// Hupeyaszih Programming Language (.hrs)

fn something(x:int32, y:int32):int32 {

}

fn main():int32 {
    var i:int32 = 0;
    var res:int32 = loop {
        var x:int32 = 0;
        i <= 10;
    } return {
        i;
    } continue { 
        x = i;
        i = i + 1;
    };

    i = 0;
    var res2:int32 = something(loop {i <= 10;} return {i;} continue {i = i + 1;}, 0);

    res2 + res;
}
