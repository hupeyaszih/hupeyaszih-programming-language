    var v25: int32 = 25; var v26: int32 = 26; var v27: int32 = 27; var v28: int32 = 28;

    var sum1: int32 = v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 +
                      v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 + v20 +
                      v21 + v22 + v23 + v24 + v25 + v26 + v27 + v28;

    var x1: int32 = sum1 + 1;  var x2: int32 = sum1 + 2;  var x3: int32 = sum1 + 3;  var x4: int32 = sum1 + 4;
    var x5: int32 = sum1 + 5;  var x6: int32 = sum1 + 6;  var x7: int32 = sum1 + 7;  var x8: int32 = sum1 + 8;
    var x9: int32 = sum1 + 9;  var x10: int32 = sum1 + 10; var x11: int32 = sum1 + 11; var x12: int32 = sum1 + 12;
