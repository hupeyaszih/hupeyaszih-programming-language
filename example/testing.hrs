// Hupeyaszih Programming Language (.hrs)

fn calc(a:int32, b:int32, c:int32) : int32 {
    a * b + c;
}

fn main() : int32 {
    var a:int32 = 10;
    var b:int32 = 20;
    var c:int32 = 30;

    var ptr1:*int32 = &a;
    var ptr2:*int32 = &b;
    var pptr:**int32 = &ptr1;

    *ptr2 = 25;
    pptr = &ptr2;
    **pptr = 40;

    var temp:int32 = *ptr1 * **pptr + *(ptr1 + 8);

    *(ptr1 + 4) = 99;

    var res1:int32 = calc(*ptr1, **pptr, *(ptr2 + 12));

    ptr1 = &c;
    *ptr1 = res1 + temp;

    var final_val:int32 = (*ptr1 + *ptr2) * (**pptr - *(ptr1 + 4));

    var rrrr:bool = !final_val;
    var rrr:int32 = rrrr + -1;
    
    var i:int32 = 20;
    loop {
        i >= 0;
    }return{
        i;
    }continue{
        i = i - 1;
    }

    rrr;
}
