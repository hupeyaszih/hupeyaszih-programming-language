fn main() : int32 {
    var len:int32  = 3;
    var len2:int32 = 2;
    var arr:[[int32, 2], 3];


    var i:int32 = 0;
    var k:int32 = 0;
    loop {
        i < len;
    } return {
      
    } continue {
        loop {
            k < len2;
        } return {

        } continue {
            set_element(arr+k*8, i, (i+1)*10);
            k = k + 1;
        }
        i = i + 1;
    }

&i;
&k;
    // get_element(*arr, 2);
    *(*arr);
}

fn get_element(arr:*int32, index:int32) : int32 {
    *(arr + index * 4);
}

fn set_element(arr:*int32, index:int32, value:int32) : int32 {
    *(arr + index * 4) = value;
    0;
}
