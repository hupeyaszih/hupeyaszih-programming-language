// Hupeyaszih Programming Language (.hrs)
// Example 3: Direct Linux Kernel I/O via Inline Assembly (sys_write). And global variables

var x:int32 = 13;

fn sys_write(buffer_ptr: *char, length: int32) : int32 {
    asm "
    mov rdx, rsi    # Arg 3: count (length of string)
    mov rsi, rdi    # Arg 2: *buf (pointer to memory)
    mov rdi, 1      # Arg 1: fd = 1 (stdout)
    mov rax, 1      # RAX = 1 (Linux sys_write syscall)
    syscall";       // Trigger Linux kernel

    0;
}

fn main() : int32 {
    var str: *char = "Hello World!\n";
    sys_write(str, x);

    var res:int32 = 20 + x;

    res;
}
