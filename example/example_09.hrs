#define STRING_COUNT 3 $

fn main() : int32 {
    var lengths:[int32, STRING_COUNT] = {12, 11, 7};
    var strings:[*char, STRING_COUNT] = {"hello world\n", "HUPEYASZIH\n", "Poyraz\n"};

    var i:int32 = 0;
    loop {i < STRING_COUNT;} return {i;} continue {
        print(strings[i], lengths[i]);
        i = i + 1;
    }

    0;
}

fn print(buffer_ptr: *char, length: int32) : int32 {
    asm "
    mov rdx, rsi
    mov rsi, rdi
    mov rdi, 1
    mov rax, 1
    syscall";

    0;
}
