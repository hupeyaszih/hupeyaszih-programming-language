
fn main() : int32 {
    var arr:[int32, 5];
    var len:int32 = 5;
    var i:int32 = 0;
    loop {
        i < len;
    } return {
        i;
    } continue {
        arr[i] = (i+1) * 10;
        i = i + 1;
    }

    var total:int32 = 0;
    i = 0;
    loop {
        i < len;
    } return {
        total;
    } continue {
        total = total + arr[i];
        i = i + 1;
    }
}
